# 复制本文件为 .env 即可生效（不需要任何密钥，本地模型）
# Ollama 服务地址（默认本机 11434）
OLLAMA_BASE_URL=http://localhost:11434

# 使用的模型名（需先通过 `ollama pull <模型名>` 拉取到本地）
# 推荐入门模型（注意：模型名必须和 `ollama list` 显示的一致，否则会报错）：
#   qwen2.5:3b          阿里通义千问，中文友好、轻量(约 2GB)，学习/低配首选
#   qwen2.5:latest      同上但更大(约 4.7GB)，效果更好
#   llama3.2:latest     英文更顺，约 2GB
#   bge-m3:latest       是【向量嵌入模型】，只能做检索/RAG，不能用来聊天！
MODEL_NAME=qwen2.5:3b
